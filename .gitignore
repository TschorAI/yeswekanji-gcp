# Not in git: these live on the project's drive (.claude/sync.conf) and on the task board.
# Anchored to the root, so that a src/data/ or src/sources/ folder stays versioned.
/data/
/sources/
/tasks/
# Generated from src/: never versioned. Rebuild it, or fetch it from the drive.
/out/

# Documents: no PDF, no video, no build files.
*.pdf
*.mp4
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
~$*
*~

# Python and local state
/.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.claude/state/
.claude/settings.local.json
.env
*.env
.env.*
.DS_Store
Thumbs.db

# Local only: agent rules and tooling, private notes.
/.claude/
/CLAUDE.md
/private/
